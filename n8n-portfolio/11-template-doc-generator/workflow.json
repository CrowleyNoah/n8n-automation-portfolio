    {
      "parameters": {
        "jsCode": "const t = $json;\nconst body = t.body || {};\nlet record_outcome, document_number, cached = null;\nif (t.statusCode === 201) { record_outcome = 'new'; document_number = body.document_number; }\nelse if (t.statusCode === 409) {\n  const existing = body.existing || {};\n  document_number = existing.document_number;\n  if (existing.status === 'completed') { record_outcome = 'existing_completed'; cached = { document_number, archive_url: existing.archive_url }; }\n  else if (['pending', 'failed_needs_retry', 'rejected_totals_mismatch'].includes(existing.status)) record_outcome = 'existing_retry';\n  else record_outcome = 'existing_unknown_status';\n} else { record_outcome = 'store_error'; }\nreturn [{ json: { ...t, record_outcome, document_number, cached } }];"
      },
