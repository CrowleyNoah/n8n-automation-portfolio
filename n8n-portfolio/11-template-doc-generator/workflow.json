    {
      "parameters": {
        "jsCode": "// Hand-rolled minimal mustache-style renderer: {{field}}, {{#if field}}..{{/if}}, {{#each list}}..{{/each}},\n// plus two formatting helpers: {{currency amount}} and {{date value}}. No external templating library --\n// deliberately small and auditable rather than pulling in a full engine for three constructs.\nconst t = $json;\nconst data = t.merge_data || {};\nconst warnings = [];\nconst getPath = (obj, path) => path.split('.').reduce((o, k) => (o == null ? undefined : o[k]), obj);\n\nfunction fmtCurrency(v) {\n  const n = Number(v);\n  if (Number.isNaN(n)) { warnings.push(`currency helper got a non-numeric value: ${v}`); return String(v); }\n  return '$' + n.toFixed(2).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n}\nfunction fmtDate(v) {\n  const d = new Date(v);\n  if (isNaN(d.getTime())) { warnings.push(`date helper got an unparseable value: ${v}`); return String(v); }\n  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });\n}\nfunction resolve(expr, scope) {\n  const m = expr.match(/^(currency|date)\\s+(.+)$/);\n  if (m) { const v = getPath(scope, m[2].trim()); return m[1] === 'currency' ? fmtCurrency(v) : fmtDate(v); }\n  const v = getPath(scope, expr.trim());\n  if (v === undefined || v === null) { warnings.push(`unresolved field: ${expr.trim()}`); return ''; }\n  return v;\n}\nfunction render(tpl, scope) {\n  // {{#each path}}...{{/each}} -- must run before {{#if}} since a list item's inner {{#if}} needs its own scope\n  tpl = tpl.replace(/\\{\\{#each\\s+([\\w.]+)\\}\\}([\\s\\S]*?)\\{\\{\\/each\\}\\}/g, (_, path, inner) => {\n    const list = getPath(scope, path.trim());\n    if (!Array.isArray(list)) { warnings.push(`#each ${path.trim()} is not an array`); return ''; }\n    return list.map(item => render(inner, item)).join('');\n  });\n  // {{#if path}}...{{/if}} -- truthy-gated block, no else clause (kept intentionally simple)\n  tpl = tpl.replace(/\\{\\{#if\\s+([\\w.]+)\\}\\}([\\s\\S]*?)\\{\\{\\/if\\}\\}/g, (_, path, inner) => {\n    const v = getPath(scope, path.trim());\n    return v ? render(inner, scope) : '';\n  });\n  // plain/helper substitutions\n  tpl = tpl.replace(/\\{\\{([^#/][^}]*)\\}\\}/g, (_, expr) => resolve(expr, scope));\n  return tpl;\n}\n\nlet computed_totals = null, has_discrepancy = false;\nif (t.document_type === 'invoice') {\n  const items = data.line_items || [];\n  const subtotal = items.reduce((s, i) => s + (Number(i.quantity) || 0) * (Number(i.unit_price) || 0), 0);\n  const taxRate = Number(data.tax_rate) || 0;\n  const tax = subtotal * taxRate;\n  const total = subtotal + tax;\n  computed_totals = { subtotal: Math.round(subtotal * 100) / 100, tax: Math.round(tax * 100) / 100, total: Math.round(total * 100) / 100 };\n  if (data.total !== undefined && Math.abs(Number(data.total) - computed_totals.total) > 0.01) has_discrepancy = true;\n  data.computed_subtotal = computed_totals.subtotal;\n  data.computed_tax = computed_totals.tax;\n  data.computed_total = computed_totals.total;\n}\n\nconst rendered_html = render(t.template_html || '', data);\nreturn [{ json: { ...t, rendered_html, warnings, computed_totals, has_discrepancy } }];"
      },
