        "jsCode": "const t = $json;\nconst found = t.statusCode >= 200 && t.statusCode < 300;\nconst state = found ? (t.body || {}) : {};\nconst status = state.status || 'closed'; // closed | open\nconst now = Date.now();\nlet breaker_status;\nif (status === 'closed') breaker_status = 'closed';\nelse if (now >= (state.next_probe_at || 0)) breaker_status = 'open_due_probe';\nelse breaker_status = 'open_no_probe';\nreturn [{ json: { integration: t.integration, resource_path: t.resource_path, params: t.params,\n  cache_key: t.cache_key, max_staleness_seconds: t.max_staleness_seconds,\n  breaker_status, next_probe_at: state.next_probe_at || null, trip_count: state.trip_count || 0 } }];"
