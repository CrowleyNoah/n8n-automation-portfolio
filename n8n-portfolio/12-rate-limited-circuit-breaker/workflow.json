        "jsCode": "const t = $json;\nconst raw = (t.headers && (t.headers['retry-after'] || t.headers['Retry-After'])) || null;\nlet retry_after_seconds = 5; // sane default if the provider didn't send one\nif (raw) {\n  const asInt = parseInt(raw, 10);\n  if (!Number.isNaN(asInt) && String(asInt) === String(raw).trim()) retry_after_seconds = asInt; // seconds form\n  else { const asDate = new Date(raw); if (!isNaN(asDate.getTime())) retry_after_seconds = Math.max(1, Math.round((asDate.getTime() - Date.now()) / 1000)); } // HTTP-date form\n}\nreturn [{ json: { ...t, retry_after_seconds: Math.min(retry_after_seconds, 120) } }];"
