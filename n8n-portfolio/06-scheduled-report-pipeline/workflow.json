        "bodyParameters": {
          "parameters": [
            { "name": "to", "value": "={{ $json.email }}" },
            { "name": "subject", "value": "={{ 'Weekly Ops Report ' + $json.period_start + ' - ' + $json.period_end }}" },
            { "name": "attachment", "value": "={{ $binary.data }}", "parameterType": "formBinaryData" }
