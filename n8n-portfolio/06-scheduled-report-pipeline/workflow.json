    {
      "parameters": {
        "jsCode": "const items = $json.results || [];\nconst failed = items.filter(r => r.status === 'failed').map(r => r.email);\nreturn [{ json: {\n  run_id: items[0]?.run_id, triggered_by: items[0]?.triggered_by,\n  total: items.length, sent: items.length - failed.length, failed_count: failed.length, failed_recipients: failed\n} }];"
      },
