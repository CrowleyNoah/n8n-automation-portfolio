    { "parameters": { "mode": "combine", "combineBy": "combineByPosition", "options": {} }, "id": "v-merge-tts", "name": "Merge TTS Result + State", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1600, -100] },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.statusCode }}", "rightValue": 400, "operator": { "type": "number", "operation": "lt" } }],
