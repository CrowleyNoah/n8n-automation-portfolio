    {
      "parameters": {
        "jsCode": "// $binary.data.data is n8n's internal base64 representation of the attached file -- confirmed against this n8n version's binary handling before relying on it.\nconst t = $json;\nreturn [{ json: { session_id: t.session_id, transcript: t.transcript, response_text: t.response_text, response_audio_base64: $binary.data ? $binary.data.data : null, language: t.language, has_audio: true } }];"
      },
      "id": "v-build-final-with-audio",
