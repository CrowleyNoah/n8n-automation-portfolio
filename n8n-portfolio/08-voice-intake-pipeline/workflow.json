      "parameters": {
        "jsCode": "const t = $json;\nreturn [{ json: { session_id: t.session_id, transcript: t.transcript, response_text: t.response_text, response_audio_base64: null, language: t.language, has_audio: false, note: 'audio synthesis failed -- text-only response returned' } }];"
      },
      "id": "v-build-final-text-only",
      "name": "Build Final Response (Text Only)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, -20],
      "notes": "A TTS outage degrades to text, not to total failure -- an important accessibility/robustness fallback, not just a nice-to-have."
    },
    {
      "parameters": {
