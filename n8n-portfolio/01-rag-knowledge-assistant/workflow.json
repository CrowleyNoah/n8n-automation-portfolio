      },
      "id": "q-respond-invalid",
      "name": "Respond 400 (query)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-960, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EMBEDDINGS_API_URL }}/embed",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "input", "value": "={{ $json.query }}" },
