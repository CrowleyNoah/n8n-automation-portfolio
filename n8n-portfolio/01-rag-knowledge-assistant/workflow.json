      "id": "q-if-hasresults",
      "name": "Any Matches?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-560, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"answer\": \"No relevant documents were found in the knowledge base for this query.\", \"sources\": [] } }}",
        "options": { "responseCode": 200 }
      },
      "id": "q-respond-noresults",
      "name": "Respond No Matches",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-360, 220]
    },
    {
      "parameters": {
        "jsCode": "// Build grounded context and enforce a token/char budget so the LLM prompt doesn't blow the context window.\nconst results = $json.result || [];\nconst MAX_CONTEXT_CHARS = 6000;\nlet context = '';\nconst sources = [];\nfor (const r of results) {\n  const snippet = r.payload?.text || '';\n  if ((context + snippet).length > MAX_CONTEXT_CHARS) break;\n  context += `\\n---\\n[source: ${r.payload?.doc_id}]\\n${snippet}`;\n  sources.push({ doc_id: r.payload?.doc_id, score: r.score, chunk_index: r.payload?.chunk_index });\n}\nreturn [{ json: { context, sources, query: $('Validate Query Input').item.json.query } }];"
      },
      "id": "q-buildcontext",
      "name": "Build Grounded Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-360, 40]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LLM_API_URL }}/v1/chat/completions",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "={{ $env.CHAT_MODEL || 'local-model' }}" },
            { "name": "messages", "value": "={{ [ { role: 'system', content: 'Answer ONLY using the provided context. If the context does not contain the answer, say you do not have enough information. Cite sources by doc_id.' }, { role: 'user', content: `Context:\\n${$json.context}\\n\\nQuestion: ${$json.query}` } ] }}" },
            { "name": "temperature", "value": "0.2" }
          ]
        },
        "options": { "timeout": 30000, "response": { "response": { "neverError": true } } }
      },
      "id": "q-llm",
      "name": "Generate Grounded Answer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-160, 40],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.choices }}", "rightValue": null, "operator": { "type": "array", "operation": "notEmpty" } }
          ],
          "combinator": "and"
        }
      },
      "id": "q-if-llmok",
      "name": "LLM Call OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [40, 40]
    },
    {
      "parameters": {
