          ],
          "combinator": "and"
        }
      },
      "id": "q-if-valid",
      "name": "Query Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-1160, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
