      "typeVersion": 4.2,
      "position": [-760, 100],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.result }}", "rightValue": null, "operator": { "type": "array", "operation": "notEmpty" } }
          ],
          "combinator": "and"
