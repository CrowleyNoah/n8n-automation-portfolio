{
  "name": "01 - RAG Knowledge Assistant",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rag/ingest",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "ing-trigger",
      "name": "Ingest Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1600, -300],
      "webhookId": "rag-ingest"
    },
    {
      "parameters": {
        "jsCode": "// Validate ingest payload. Edge cases: missing body, missing both text/source_url, empty doc_id, oversized payload.\nconst body = $input.first().json.body || {};\nconst errors = [];\n\nif (!body.doc_id || typeof body.doc_id !== 'string' || body.doc_id.trim() === '') {\n  errors.push('doc_id is required and must be a non-empty string');\n}\nif (!body.text && !body.source_url) {\n  errors.push('either text or source_url must be provided');\n}\nif (body.text && body.text.length > 500000) {\n  errors.push('text exceeds 500,000 char ingestion limit; split the document client-side');\n}\nif (body.source_url && !/^https?:\\/\\//i.test(body.source_url)) {\n  errors.push('source_url must be a valid http(s) URL');\n}\n\nif (errors.length) {\n  return [{ json: { valid: false, errors, statusCode: 400 } }];\n}\n\nreturn [{ json: { valid: true, doc_id: body.doc_id.trim(), text: body.text || null, source_url: body.source_url || null, metadata: body.metadata || {} } }];"
      },
      "id": "ing-validate",
      "name": "Validate Ingest Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1380, -300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.valid }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }
          ],
          "combinator": "and"
        }
      },
      "id": "ing-if-valid",
      "name": "Input Valid?",
      "type": "n8n-nodes-base.if",
