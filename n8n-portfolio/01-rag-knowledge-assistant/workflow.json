        "responseBody": "={{ { \"error\": \"llm_generation_failed\", \"sources\": $('Build Grounded Context').item.json.sources, \"message\": \"Relevant context was found but the answer could not be generated. Try again shortly.\" } }}",
        "options": { "responseCode": 503 }
      },
      "id": "q-respond-llmfail",
      "name": "Respond 503 LLM Failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [240, 140]
    }
