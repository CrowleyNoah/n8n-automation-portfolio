    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rag/query",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "q-trigger",
      "name": "Query Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1600, 200],
      "webhookId": "rag-query"
    },
    {
      "parameters": {
        "jsCode": "// Edge cases: missing/empty query, oversized query, invalid top_k.\nconst body = $input.first().json.body || {};\nconst errors = [];\nif (!body.query || typeof body.query !== 'string' || body.query.trim() === '') {\n  errors.push('query is required and must be a non-empty string');\n}\nif (body.query && body.query.length > 2000) {\n  errors.push('query exceeds 2000 char limit');\n}\nlet topK = parseInt(body.top_k, 10);\nif (isNaN(topK) || topK < 1) topK = 5;\nif (topK > 20) topK = 20;\n\nif (errors.length) return [{ json: { valid: false, errors } }];\nreturn [{ json: { valid: true, query: body.query.trim(), top_k: topK } }];"
      },
      "id": "q-validate",
      "name": "Validate Query Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1380, 200]
    },
