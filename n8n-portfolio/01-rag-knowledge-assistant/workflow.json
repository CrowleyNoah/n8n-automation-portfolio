        "responseBody": "={{ { \"answer\": $json.choices[0].message.content, \"sources\": $('Build Grounded Context').item.json.sources } }}",
        "options": { "responseCode": 200 }
      },
      "id": "q-respond-ok",
      "name": "Respond 200 With Answer",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [240, -20]
    },
