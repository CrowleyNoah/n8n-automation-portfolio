      "position": [-560, -480]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"source_fetch_failed\", \"status\": $json.statusCode, \"doc_id\": $('Validate Ingest Input').item.json.doc_id } }}",
        "options": { "responseCode": 502 }
      },
      "id": "ing-respond-fetchfail",
      "name": "Respond 502 Fetch Failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-360, -540]
    },
    {
      "parameters": {
        "jsCode": "// Chunk text with overlap. Edge cases: empty/whitespace-only text after fetch, HTML source (strip tags), tiny docs (<chunkSize).\nlet text = $json.text || $json.data || '';\nif (typeof text !== 'string') text = String(text);\n\n// crude HTML strip if source came from a URL fetch\nif (text.includes('<html') || text.includes('<body')) {\n  text = text.replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n             .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n             .replace(/<[^>]+>/g, ' ')\n             .replace(/\\s+/g, ' ')\n             .trim();\n}\n\nif (!text || text.trim().length === 0) {\n  return [{ json: { error: 'empty_document', doc_id: $('Validate Ingest Input').item.json.doc_id } }];\n}\n\nconst chunkSize = 1000;\nconst overlap = 150;\nconst chunks = [];\nlet start = 0;\nwhile (start < text.length) {\n  const end = Math.min(start + chunkSize, text.length);\n  chunks.push(text.slice(start, end));\n  if (end === text.length) break;\n  start += (chunkSize - overlap);\n}\n\nconst docId = $('Validate Ingest Input').item.json.doc_id;\nconst metadata = $('Validate Ingest Input').item.json.metadata;\nreturn chunks.map((chunk, i) => ({\n  json: {\n    doc_id: docId,\n    chunk_id: `${docId}::chunk_${i}`,\n    chunk_index: i,\n    total_chunks: chunks.length,\n    text: chunk,\n    metadata\n  }\n}));"
      },
      "id": "ing-chunk",
      "name": "Chunk Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-360, -300]
    },
    {
      "parameters": { "batchSize": 5, "options": {} },
      "id": "ing-batch",
      "name": "Batch Chunks (5 at a time)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-160, -300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EMBEDDINGS_API_URL }}/embed",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "input", "value": "={{ $json.text }}" },
            { "name": "model", "value": "={{ $env.EMBEDDING_MODEL || 'nomic-embed-text' }}" }
          ]
        },
        "options": {
          "timeout": 20000,
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "ing-embed",
      "name": "Embed Chunk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, -300],
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 3000,
      "notes": "Retries handle transient 429/5xx from embedding backend. waitBetweenTries backs off before each retry."
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "ing-merge-chunk-embed",
      "name": "Merge Chunk + Embedding",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [140, -300],
      "notes": "Recombines each chunk's original fields (doc_id, chunk_id, text, metadata) with its embedding result by position. Avoids relying on $('Chunk Text').item inside the batch loop, whose pairedItem lineage isn't reliable across HTTP Request nodes mid-loop."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.embedding }}", "rightValue": null, "operator": { "type": "array", "operation": "notEmpty" } }
          ],
          "combinator": "and"
        }
      },
      "id": "ing-if-embedok",
      "name": "Embedding OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [340, -300]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.VECTOR_DB_URL }}/collections/knowledge_base/points",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "id", "value": "={{ $json.chunk_id }}" },
            { "name": "vector", "value": "={{ $json.embedding }}" },
            { "name": "payload", "value": "={{ { text: $json.text, doc_id: $json.doc_id, chunk_index: $json.chunk_index, metadata: $json.metadata } }}" }
          ]
        },
        "options": { "timeout": 15000, "response": { "response": { "neverError": true } } }
      },
      "id": "ing-upsert",
      "name": "Upsert to Vector Store",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, -360],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Track embedding failures instead of dropping the chunk silently.\n// chunk_id/doc_id come from the merged item; error/message come from the failed HTTP response, if present.\nreturn [{ json: { chunk_id: $json.chunk_id, doc_id: $json.doc_id, status: 'embedding_failed', error: $json.error || $json.message || 'unknown' } }];"
      },
      "id": "ing-log-embedfail",
      "name": "Log Embedding Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [540, -220]
    },
    {
      "parameters": {},
      "id": "ing-noop-loopback",
      "name": "Loop Back",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [740, -300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ingested\", \"doc_id\": $('Validate Ingest Input').item.json.doc_id, \"chunks\": $('Chunk Text').all().length } }}",
        "options": { "responseCode": 200 }
      },
      "id": "ing-respond-ok",
      "name": "Respond 200 Ingested",
