      "position": [2800, 60],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "notes": "Last-resort tier -- no further fallback below this. A failure here means the entire request fails."
    },
    { "parameters": { "mode": "combine", "combineBy": "combineByPosition", "options": {} }, "id": "l-merge-premium", "name": "Merge Premium Result + State", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [3000, 60] },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.statusCode }}", "rightValue": 400, "operator": { "type": "number", "operation": "lt" } }],
          "combinator": "and"
        }
      },
      "id": "l-if-premium-ok",
      "name": "Premium Call OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3200, 60]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CIRCUIT_BREAKER_API_URL }}/record-failure?provider=premium",
        "sendBody": true,
        "bodyParameters": { "parameters": [{ "name": "status", "value": "={{ $json.statusCode }}" }] },
        "options": { "timeout": 5000, "response": { "response": { "neverError": true } } }
      },
      "id": "l-record-breaker3-fail",
      "name": "Record Premium Breaker Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3400, 200]
    },
    {
      "parameters": {
        "jsCode": "const t = $json;\nreturn [{ json: { request_id: t.request_id, reason: 'all_providers_failed', tiers_attempted: ['local_llm', 'midtier', 'premium'] } }];"
      },
      "id": "l-fail-premium",
      "name": "Build Failure (All Providers Failed)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3600, 260]
    },
    {
      "parameters": {
        "jsCode": "const t = $json;\nconst text = (t.body?.content && t.body.content[0] && t.body.content[0].text) || '';\nconst usage = t.body?.usage;\nconst cost_usd = usage ? ((usage.input_tokens || 0) + (usage.output_tokens || 0)) * 0.000015 : 0.05;\nreturn [{ json: { text, provider: 'premium', cost_usd, request_id: t.request_id, prompt: t.prompt, task_type: t.task_type, max_tokens: t.max_tokens, require_json: t.require_json, cache_key: t.cache_key, breakers: t.breakers } }];"
      },
      "id": "l-extract-premium",
      "name": "Extract Premium Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3400, -60],
