          ]
        },
        "options": { "timeout": 8000, "response": { "response": { "neverError": true } } }
      },
      "id": "b-notify-denied",
      "name": "Notify Requester (Denied)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1000, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ACTION_EXECUTOR_API_URL }}/execute",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "action_id", "value": "={{ $json.action_id }}" },
            { "name": "action_type", "value": "={{ $json.action_type }}" },
            { "name": "details", "value": "={{ $json.details }}" },
            { "name": "amount", "value": "={{ $json.amount }}" }
          ]
        },
        "options": { "timeout": 20000, "response": { "response": { "neverError": true, "fullResponse": true } } }
      },
      "id": "b-execute-approved-action",
      "name": "Execute Approved Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1000, 100],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": { "mode": "combine", "combineBy": "combineByPosition", "options": {} },
      "id": "b-merge-execute",
      "name": "Merge Execution Result + Decision",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [-800, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.statusCode }}", "rightValue": 400, "operator": { "type": "number", "operation": "lt" } }],
          "combinator": "and"
        }
      },
      "id": "b-if-execute-ok",
      "name": "Execution OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-600, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NOTIFY_API_URL }}/send",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "to", "value": "={{ $json.requested_by }}" },
            { "name": "message", "value": "={{ $json.action_id + ' was approved by ' + $json.responder + ' and completed.' }}" }
          ]
        },
        "options": { "timeout": 8000, "response": { "response": { "neverError": true } } }
      },
      "id": "b-notify-approved",
      "name": "Notify Requester (Approved & Done)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "text", "value": "={{ 'Action ' + $json.action_id + ' was APPROVED but execution failed (status ' + $json.statusCode + '). Needs manual handling.' }}" }
          ]
        },
        "options": { "timeout": 8000, "response": { "response": { "neverError": true } } }
      },
