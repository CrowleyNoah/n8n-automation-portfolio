{
  "name": "05 - Human-in-the-Loop Approval Gate",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "approvals/request", "responseMode": "responseNode", "options": {} },
      "id": "a-trigger",
      "name": "Request Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-2600, 0],
      "webhookId": "approvals-request"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst errors = [];\nif (!body.action_id || typeof body.action_id !== 'string' || body.action_id.trim() === '') errors.push('action_id is required');\nif (!body.action_type || typeof body.action_type !== 'string') errors.push('action_type is required');\nif (!body.requested_by || typeof body.requested_by !== 'string') errors.push('requested_by is required');\nif (!body.summary || typeof body.summary !== 'string') errors.push('summary is required');\n\nlet timeoutMinutes = parseInt(body.timeout_minutes, 10);\nif (isNaN(timeoutMinutes) || timeoutMinutes <= 0) timeoutMinutes = 60;\nif (timeoutMinutes > 1440) timeoutMinutes = 1440; // cap at 24h so a bad input can't leave a Wait node parked indefinitely\n\nif (errors.length) return [{ json: { valid: false, errors } }];\nreturn [{ json: {\n  valid: true, action_id: body.action_id.trim(), action_type: body.action_type,\n  requested_by: body.requested_by, summary: body.summary, details: body.details || {},\n  amount: body.amount ?? null, timeout_minutes: timeoutMinutes\n} }];"
      },
      "id": "a-validate",
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-2400, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.valid }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }],
          "combinator": "and"
        }
      },
      "id": "a-if-valid",
      "name": "Request Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-2200, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"validation_failed\", \"details\": $json.errors } }}",
        "options": { "responseCode": 400 }
      },
      "id": "a-respond-invalid",
      "name": "Respond 400 (Request Invalid)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-2000, 180]
    },
    {
      "parameters": {
        "method": "GET",
