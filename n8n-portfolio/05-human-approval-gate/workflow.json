        "bodyParameters": {
          "parameters": [
            { "name": "decision", "value": "auto_declined" },
            { "name": "resolved_by", "value": "system_timeout" }
          ]
        },
        "options": { "timeout": 8000, "response": { "response": { "neverError": true, "fullResponse": true } } }
      },
      "id": "a-auto-decline-resolve",
      "name": "Atomically Auto-Decline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, -520],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "notes": "Same compare-and-set endpoint the human-decision path uses. Only succeeds if the record is still 'pending' at the moment this call lands -- closes the race where a human approves in the last second between the status check above and this call."
    },
    {
      "parameters": { "mode": "combine", "combineBy": "combineByPosition", "options": {} },
      "id": "a-merge-autodecline",
      "name": "Merge Auto-Decline Result",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [200, -520]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.statusCode }}", "rightValue": 400, "operator": { "type": "number", "operation": "lt" } }],
          "combinator": "and"
        }
      },
      "id": "a-if-autodecline-ok",
      "name": "Auto-Decline Won Race?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [400, -520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "text", "value": "={{ 'Approval request ' + $json.action_id + ' (' + $json.summary + ') auto-declined after ' + $json.timeout_minutes + ' minutes with no response.' }}" }
          ]
        },
        "options": { "timeout": 8000, "response": { "response": { "neverError": true } } }
      },
      "id": "a-notify-timeout-declined",
      "name": "Notify Auto-Decline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, -580]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { note: 'no action needed - approval was already resolved before this check landed', action_id: $json.action_id } }];"
      },
      "id": "a-log-noop",
      "name": "Log No-Op",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, -320],
      "notes": "Shared dead-end for two distinct 'someone beat us to it' cases: the record was already resolved before the timeout check, or the human resolved it in the split second between that check and our own auto-decline call."
    },
    {
      "parameters": { "httpMethod": "POST", "path": "approvals/respond", "responseMode": "responseNode", "options": {} },
      "id": "b-trigger",
      "name": "Approval Decision Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-2600, 300],
      "webhookId": "approvals-respond",
      "notes": "Target for both Slack's interactive-button callback and a direct API decision call, so it accepts either shape."
    },
    {
      "parameters": {
        "jsCode": "// Normalize either a Slack interaction payload or a direct {action_id, decision, responder} body into one shape.\nconst item = $input.first();\nconst body = item.json.body || {};\nlet action_id, decision, responder;\n\nif (body.payload) {\n  let slackPayload;\n  try { slackPayload = typeof body.payload === 'string' ? JSON.parse(body.payload) : body.payload; }\n  catch (e) { return [{ json: { valid: false, errors: ['unparseable Slack interaction payload'] } }]; }\n  const action = slackPayload.actions && slackPayload.actions[0];\n  action_id = action ? action.value : undefined;\n  decision = action && action.action_id === 'approve_btn' ? 'approve' : (action && action.action_id === 'deny_btn' ? 'deny' : undefined);\n  responder = slackPayload.user ? (slackPayload.user.username || slackPayload.user.id) : undefined;\n} else {\n  action_id = body.action_id;\n  decision = body.decision;\n  responder = body.responder;\n}\n\nconst errors = [];\nif (!action_id || typeof action_id !== 'string') errors.push('action_id could not be determined from the request');\nif (!['approve', 'deny'].includes(decision)) errors.push('decision must be \"approve\" or \"deny\"');\nif (!responder) errors.push('responder is required');\n\nif (errors.length) return [{ json: { valid: false, errors } }];\nreturn [{ json: { valid: true, action_id, decision, responder } }];"
      },
      "id": "b-parse",
      "name": "Parse Decision Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-2400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.valid }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }],
          "combinator": "and"
        }
      },
      "id": "b-if-valid",
      "name": "Decision Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-2200, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"invalid_decision_payload\", \"details\": $json.errors } }}",
        "options": { "responseCode": 400 }
      },
      "id": "b-respond-400",
      "name": "Respond 400 (Decision Invalid)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-2000, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APPROVAL_STORE_API_URL }}/approvals/{{ $json.action_id }}/resolve",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "decision", "value": "={{ $json.decision }}" },
            { "name": "resolved_by", "value": "={{ $json.responder }}" }
          ]
        },
        "options": { "timeout": 8000, "response": { "response": { "neverError": true, "fullResponse": true } } }
      },
      "id": "b-resolve",
      "name": "Atomically Resolve Decision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-2000, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "notes": "Same compare-and-set semantics as the timeout path uses. A double-click on Approve, or a click arriving after the timeout already fired, both land here as a no-op 409 rather than double-executing anything. Assumed to return the full approval record (action_type/summary/amount/details) on success, so nothing further needs to be re-fetched."
    },
    {
      "parameters": { "mode": "combine", "combineBy": "combineByPosition", "options": {} },
      "id": "b-merge-resolve",
      "name": "Merge Resolve Result + Decision",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [-1800, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.statusCode }}", "rightValue": 400, "operator": { "type": "number", "operation": "lt" } }],
          "combinator": "and"
        }
      },
      "id": "b-if-resolve-ok",
      "name": "Resolve Claimed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-1600, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"already_resolved\", \"action_id\": $json.action_id } }}",
        "options": { "responseCode": 200 }
      },
      "id": "b-respond-already-resolved",
      "name": "Respond Already Resolved",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-1400, 460]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"acknowledged\", \"action_id\": $json.action_id } }}",
        "options": { "responseCode": 200 }
      },
      "id": "b-respond-ack",
      "name": "Respond 200 Acknowledged",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-1400, 220],
      "notes": "Slack expects a fast ack on interactive callbacks (~3s). Executing the approved action can take longer, so ack first and keep running -- same fast-ack-then-continue pattern as workflow 04."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.decision }}", "rightValue": "approve", "operator": { "type": "string", "operation": "equals" } }],
          "combinator": "and"
        }
      },
      "id": "b-if-decision-approve",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-1200, 220]
    },
    {
