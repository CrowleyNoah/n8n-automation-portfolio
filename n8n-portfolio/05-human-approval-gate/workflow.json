      "position": [-2000, -80],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "notes": "Courtesy pre-check to avoid sending a second Slack prompt for a request the caller retried. The atomic create below is the real guard against races, not this."
    },
    {
      "parameters": { "mode": "combine", "combineBy": "combineByPosition", "options": {} },
      "id": "a-merge-existing",
