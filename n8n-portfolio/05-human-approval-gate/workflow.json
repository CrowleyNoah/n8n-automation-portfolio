            { "name": "blocks", "value": "={{ [ { type: 'actions', elements: [ { type: 'button', text: { type: 'plain_text', text: 'Approve' }, action_id: 'approve_btn', value: $json.action_id }, { type: 'button', text: { type: 'plain_text', text: 'Deny' }, action_id: 'deny_btn', value: $json.action_id } ] } ] }}" }
          ]
        },
        "options": { "timeout": 8000, "response": { "response": { "neverError": true } } }
      },
      "id": "a-send-slack",
      "name": "Send Slack Approval Prompt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-800, -100],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "notes": "Fire-and-forget relative to the webhook response -- a Slack outage shouldn't stop the caller from getting a 'pending' acknowledgement, and the timeout path below still protects the action either way."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"pending\", \"action_id\": $json.action_id } }}",
        "options": { "responseCode": 200 }
      },
      "id": "a-respond-pending",
      "name": "Respond 200 Pending",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-800, -260],
      "notes": "n8n keeps executing after this node fires -- the Wait branch below continues in the same execution to enforce the timeout, without the caller waiting on it."
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": "={{ $json.timeout_minutes }}",
        "unit": "minutes"
      },
      "id": "a-wait-timeout",
      "name": "Wait Until Timeout",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [-800, -420],
      "notes": "Pauses this execution for timeout_minutes. If a human resolves the approval before this elapses, this branch still fires later -- the status check right after is what makes that safe (see Already Resolved? below)."
    },
    {
      "parameters": {
        "method": "GET",
