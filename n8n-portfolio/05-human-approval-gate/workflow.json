        "options": { "timeout": 5000, "response": { "response": { "neverError": true } } }
      },
      "id": "a-check-status-after-wait",
      "name": "Check Status After Wait",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-600, -420],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "parameters": { "mode": "combine", "combineBy": "combineByPosition", "options": {} },
      "id": "a-merge-afterwait",
