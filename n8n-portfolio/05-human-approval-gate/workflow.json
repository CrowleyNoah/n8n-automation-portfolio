      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1400, -20],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
      "notes": "The store rejects (409) if action_id already exists -- this compare-and-set create is the authoritative dedup guard, not the pre-check above, which can't fully close the race between two near-simultaneous requests."
    },
