        [{ "node": "Refund Check API", "type": "main", "index": 0 }],
        [{ "node": "Unknown Tool Handler", "type": "main", "index": 0 }]
      ]
    },
    "Order Lookup API": { "main": [[{ "node": "Merge Order Result + State", "type": "main", "index": 0 }]] },
    "Merge Order Result + State": { "main": [[{ "node": "Append Observation", "type": "main", "index": 0 }]] },
    "KB Search API": { "main": [[{ "node": "Merge KB Result + State", "type": "main", "index": 0 }]] },
    "Merge KB Result + State": { "main": [[{ "node": "Append Observation", "type": "main", "index": 0 }]] },
    "Refund Check API": { "main": [[{ "node": "Merge Refund Result + State", "type": "main", "index": 0 }]] },
    "Merge Refund Result + State": { "main": [[{ "node": "Append Observation", "type": "main", "index": 0 }]] },
    "Unknown Tool Handler": { "main": [[{ "node": "Append Observation", "type": "main", "index": 0 }]] },
    "Build Parse Error Observation": { "main": [[{ "node": "Append Observation", "type": "main", "index": 0 }]] },
    "Append Observation": { "main": [[{ "node": "Iteration < Max?", "type": "main", "index": 0 }]] },
    "Iteration < Max?": {
