        [{ "node": "Init ReAct State", "type": "main", "index": 0 }]
      ]
    },
    "Prepare Escalation (Low Confidence/Sensitive)": {
      "main": [
        [
          { "node": "Create Helpdesk Ticket", "type": "main", "index": 0 },
          { "node": "Merge Helpdesk Result + Reason", "type": "main", "index": 1 }
        ]
      ]
    },
    "Init ReAct State": { "main": [[{ "node": "Build Agent Prompt", "type": "main", "index": 0 }]] },
    "Build Agent Prompt": {
