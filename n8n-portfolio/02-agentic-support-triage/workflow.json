        [
          { "node": "Agent Reasoning Step", "type": "main", "index": 0 },
          { "node": "Merge Agent Response + State", "type": "main", "index": 1 }
        ]
      ]
    },
    "Agent Reasoning Step": { "main": [[{ "node": "Merge Agent Response + State", "type": "main", "index": 0 }]] },
