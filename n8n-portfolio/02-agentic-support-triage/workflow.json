      ]
    },
    "Check Idempotency": { "main": [[{ "node": "Merge Idempotency + Ticket", "type": "main", "index": 0 }]] },
    "Merge Idempotency + Ticket": { "main": [[{ "node": "Already Processed?", "type": "main", "index": 0 }]] },
    "Already Processed?": {
