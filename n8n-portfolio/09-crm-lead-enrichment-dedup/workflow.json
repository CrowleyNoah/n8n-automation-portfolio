  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "leads/intake", "responseMode": "responseNode", "options": {} },
      "id": "c-trigger",
      "name": "Lead Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-3400, 0],
      "webhookId": "leads-intake"
    },
    {
      "parameters": {
        "jsCode": "// Requires NODE_FUNCTION_ALLOW_BUILTIN to include 'crypto' (same as workflows 04, 07, 08).\nconst crypto = require('crypto');\nconst body = $input.first().json.body || {};\nconst errors = [];\nif (!body.email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(body.email)) errors.push('email must be a valid email address');\nif (!body.first_name || typeof body.first_name !== 'string') errors.push('first_name is required');\nif (!body.last_name || typeof body.last_name !== 'string') errors.push('last_name is required');\nif (!body.company || typeof body.company !== 'string') errors.push('company is required');\n\nif (errors.length) return [{ json: { valid: false, errors } }];\n\n// A deterministic id from the email when the caller doesn't supply one -- a double-submitted form with no lead_id still dedupes at this layer, before fuzzy matching ever runs.\nconst lead_id = body.lead_id || crypto.createHash('sha256').update(body.email.toLowerCase().trim()).digest('hex').slice(0, 16);\n\nreturn [{ json: {\n  valid: true, lead_id, email: body.email.trim().toLowerCase(), first_name: body.first_name.trim(), last_name: body.last_name.trim(),\n  company: body.company.trim(), title: body.title || null, phone: body.phone || null, source: body.source || 'unknown', linkedin_url: body.linkedin_url || null\n} }];"
      },
      "id": "c-validate",
      "name": "Validate Lead",
