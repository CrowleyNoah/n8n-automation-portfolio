    },
    { "parameters": { "mode": "combine", "combineBy": "combineByPosition", "options": {} }, "id": "c-merge-enrich", "name": "Merge Enrichment + Lead", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [-1800, 0] },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.statusCode }}", "rightValue": 400, "operator": { "type": "number", "operation": "lt" } }],
          "combinator": "and"
        }
      },
      "id": "c-if-enrich-ok",
      "name": "Enrichment Call OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-1600, 0]
    },
    {
      "parameters": {
        "jsCode": "const t = $json;\nconst found = t.body?.found;\nif (!found) {\n  return [{ json: { lead_id: t.lead_id, email: t.email, first_name: t.first_name, last_name: t.last_name, company: t.company, title: t.title, phone: t.phone, source: t.source, enrichment_status: 'not_found', enriched: {}, company_mismatch: false } }];\n}\nconst enriched = {\n  title: t.body.title || null,\n  current_company: t.body.current_company || null,\n  company_size: t.body.company_size || null,\n  industry: t.body.industry || null\n};\nconst normalize = s => (s || '').toLowerCase().replace(/[^a-z0-9]/g, '');\nconst company_mismatch = !!(enriched.current_company && normalize(enriched.current_company) !== normalize(t.company));\nreturn [{ json: { lead_id: t.lead_id, email: t.email, first_name: t.first_name, last_name: t.last_name, company: t.company, title: t.title, phone: t.phone, source: t.source, enrichment_status: 'success', enriched, company_mismatch } }];"
      },
      "id": "c-assess-enrichment",
      "name": "Assess Enrichment Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1400, -80],
      "notes": "A found record whose current company differs from what the lead submitted is flagged rather than silently trusting either source -- could be a recent job change or a stale/incorrect submission, and only a human should decide which."
    },
    {
      "parameters": {
        "jsCode": "const t = $json;\nreturn [{ json: { lead_id: t.lead_id, email: t.email, first_name: t.first_name, last_name: t.last_name, company: t.company, title: t.title, phone: t.phone, source: t.source, enrichment_status: 'failed', enriched: {}, company_mismatch: false } }];"
      },
      "id": "c-build-unenriched",
      "name": "Build Unenriched Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1400, 100],
      "notes": "A down or slow scraper degrades the lead to unenriched rather than failing the whole intake -- enrichment is an enhancement, not a hard requirement to get a lead into the CRM."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CRM_API_URL }}/contacts/search?email={{ $json.email }}&company={{ $json.company }}",
        "options": { "timeout": 10000, "response": { "response": { "neverError": true, "fullResponse": true } } }
      },
      "id": "c-search-crm-duplicates",
      "name": "Search CRM For Candidates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1200, 0],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500
    },
    { "parameters": { "mode": "combine", "combineBy": "combineByPosition", "options": {} }, "id": "c-merge-search", "name": "Merge Search Results + Lead", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [-1000, 0] },
    {
      "parameters": {
        "jsCode": "const t = $json;\n\nfunction levenshtein(a, b) {\n  a = a || ''; b = b || '';\n  const m = a.length, n = b.length;\n  const dp = Array.from({ length: m + 1 }, () => new Array(n + 1).fill(0));\n  for (let i = 0; i <= m; i++) dp[i][0] = i;\n  for (let j = 0; j <= n; j++) dp[0][j] = j;\n  for (let i = 1; i <= m; i++) {\n    for (let j = 1; j <= n; j++) {\n      dp[i][j] = a[i - 1] === b[j - 1] ? dp[i - 1][j - 1] : 1 + Math.min(dp[i - 1][j - 1], dp[i - 1][j], dp[i][j - 1]);\n    }\n  }\n  return dp[m][n];\n}\nfunction similarity(a, b) {\n  a = (a || '').toLowerCase().trim(); b = (b || '').toLowerCase().trim();\n  if (!a && !b) return 1;\n  if (!a || !b) return 0;\n  return 1 - levenshtein(a, b) / Math.max(a.length, b.length);\n}\n\nconst candidates = t.body?.candidates || [];\nlet best = null;\nfor (const cand of candidates) {\n  if (cand.email && cand.email.toLowerCase() === t.email) {\n    best = { candidate: cand, score: 1.0, exact_email: true };\n    break;\n  }\n  const nameScore = similarity(`${t.first_name} ${t.last_name}`, `${cand.first_name} ${cand.last_name}`);\n  const companyScore = similarity(t.company, cand.company);\n  const score = nameScore * 0.6 + companyScore * 0.4;\n  if (!best || score > best.score) best = { candidate: cand, score, exact_email: false };\n}\n\nlet classification = 'new_lead';\nif (best) {\n  if (best.exact_email) classification = 'exact_match';\n  else if (best.score >= 0.85) classification = 'high_confidence';\n  else if (best.score >= 0.6) classification = 'possible_duplicate';\n}\n\nreturn [{ json: {\n  lead_id: t.lead_id, email: t.email, first_name: t.first_name, last_name: t.last_name, company: t.company, title: t.title, phone: t.phone, source: t.source,\n  enrichment_status: t.enrichment_status, enriched: t.enriched, company_mismatch: t.company_mismatch,\n  classification, match_score: best ? best.score : 0, matched_candidate: best ? best.candidate : null\n} }];"
      },
      "id": "c-score-duplicates",
      "name": "Score Fuzzy Duplicates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-800, 0],
      "notes": "Hand-rolled Levenshtein similarity on name+company, weighted 60/40. An exact email match always wins outright and stops scoring; otherwise: >=0.85 high confidence (auto-merge), 0.6-0.85 possible (flag for review), below that treated as a genuinely new lead."
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            { "outputKey": "exact_match", "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.classification }}", "rightValue": "exact_match", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } },
            { "outputKey": "high_confidence", "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.classification }}", "rightValue": "high_confidence", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } },
            { "outputKey": "possible_duplicate", "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.classification }}", "rightValue": "possible_duplicate", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "c-route-classification",
      "name": "Route By Match Classification",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [-600, 0],
      "notes": "Output 0 = exact_match, 1 = high_confidence, 2 = possible_duplicate, 3 (fallback) = new_lead."
    },
    {
      "parameters": {
        "jsCode": "// Merge rule: fill empty existing fields with new data; never overwrite an existing non-empty CRM field with incoming data. The existing record is treated as more authoritative once it has a value.\nconst t = $json;\nconst existing = t.matched_candidate || {};\nconst merged = {\n  first_name: existing.first_name || t.first_name,\n  last_name: existing.last_name || t.last_name,\n  email: existing.email || t.email,\n  company: existing.company || t.company,\n  title: existing.title || t.enriched.title || t.title,\n  phone: existing.phone || t.phone,\n  industry: existing.industry || t.enriched.industry || null,\n  company_size: existing.company_size || t.enriched.company_size || null\n};\nreturn [{ json: { lead_id: t.lead_id, existing_id: existing.id, merged, classification: t.classification, company_mismatch: t.company_mismatch } }];"
      },
      "id": "c-build-merge-payload",
      "name": "Build Merge Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, -120],
      "notes": "Fed by both 'exact_match' and 'high_confidence' -- same merge treatment either way, since both mean 'this is the same person', just discovered with different confidence."
    },
    {
