{
  "name": "04 - Secured Webhook Order Processor",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "orders/incoming", "responseMode": "responseNode", "options": { "rawBody": true } },
      "id": "o-trigger",
      "name": "Order Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-2600, 0],
      "webhookId": "orders-incoming",
      "notes": "rawBody:true is required -- HMAC must be verified against the exact bytes the sender signed, not a re-serialized JSON.stringify of the parsed body. A re-serialized body can differ in key order/whitespace and break otherwise-valid signatures."
    },
    {
      "parameters": {
        "jsCode": "// Verify HMAC signature + timestamp (replay protection). Requires NODE_FUNCTION_ALLOW_BUILTIN to include 'crypto' in this n8n instance's config.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst rawBody = typeof item.json.body === 'string' ? item.json.body : JSON.stringify(item.json.body || {});\n\nconst signature = headers['x-signature'];\nconst timestampHeader = headers['x-timestamp'];\nconst secret = $env.WEBHOOK_SIGNING_SECRET;\n\nconst errors = [];\nif (!signature) errors.push('missing x-signature header');\nif (!timestampHeader) errors.push('missing x-timestamp header');\n\nlet timestampOk = false;\nif (timestampHeader) {\n  const ts = parseInt(timestampHeader, 10);\n  const nowSec = Math.floor(Date.now() / 1000);\n  const TOLERANCE_SECONDS = 300;\n  if (isNaN(ts)) {\n    errors.push('x-timestamp header is not a valid integer');\n  } else if (Math.abs(nowSec - ts) > TOLERANCE_SECONDS) {\n    errors.push(`timestamp outside ${TOLERANCE_SECONDS}s tolerance window (possible replay)`);\n  } else {\n    timestampOk = true;\n  }\n}\n\nlet signatureOk = false;\nif (signature && timestampOk) {\n  try {\n    const signedPayload = `${timestampHeader}.${rawBody}`;\n    const expected = crypto.createHmac('sha256', secret).update(signedPayload).digest('hex');\n    const a = Buffer.from(expected, 'utf8');\n    const b = Buffer.from(signature, 'utf8');\n    signatureOk = a.length === b.length && crypto.timingSafeEqual(a, b);\n    if (!signatureOk) errors.push('signature mismatch');\n  } catch (e) {\n    errors.push(`signature comparison failed: ${e.message}`);\n  }\n}\n\nif (!signatureOk) {\n  return [{ json: { verification_failed: true, verification_error: errors.join('; '), raw_body: rawBody } }];\n}\nreturn [{ json: { verification_failed: false, raw_body: rawBody } }];"
      },
      "id": "o-verify",
      "name": "Verify Signature & Timestamp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-2400, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.verification_failed }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }],
          "combinator": "and"
        }
      },
      "id": "o-if-verify-failed",
      "name": "Verification Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-2200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SECURITY_LOG_API_URL }}/events",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "type", "value": "webhook_verification_failed" },
            { "name": "reason", "value": "={{ $json.verification_error }}" }
          ]
        },
        "options": { "timeout": 5000, "response": { "response": { "neverError": true } } }
      },
      "id": "o-log-security",
      "name": "Log Security Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-2000, 140],
      "notes": "Fire-and-forget. Feeds monitoring that alerts on a spike in failed-verification attempts (possible attack), never blocks the 401 response."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"unauthorized\", \"reason\": $json.verification_error } }}",
        "options": { "responseCode": 401 }
      },
      "id": "o-respond-401",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-2000, 0]
    },
    {
      "parameters": {
        "jsCode": "// Parse and shape-check the order payload. Signature already covers the raw bytes, but we still defensively parse/validate.\nconst t = $json;\ntry {\n  const parsed = typeof t.raw_body === 'string' ? JSON.parse(t.raw_body) : t.raw_body;\n  if (!parsed.order_id || typeof parsed.order_id !== 'string') throw new Error('order_id missing or not a string');\n  if (typeof parsed.amount !== 'number') throw new Error('amount missing or not a number');\n  if (!parsed.currency) throw new Error('currency missing');\n  if (!Array.isArray(parsed.line_items) || parsed.line_items.length === 0) throw new Error('line_items must be a non-empty array');\n  return [{ json: { parse_ok: true, order_id: parsed.order_id, amount: parsed.amount, currency: parsed.currency, line_items: parsed.line_items, customer_email: parsed.customer_email || null } }];\n} catch (e) {\n  return [{ json: { parse_ok: false, parse_error: e.message } }];\n}"
      },
      "id": "o-parse",
      "name": "Parse Order Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-2000, -140]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.parse_ok }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }],
          "combinator": "and"
        }
      },
      "id": "o-if-parse-ok",
      "name": "Payload Parses & Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-1800, -140]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"malformed_payload\", \"reason\": $json.parse_error } }}",
        "options": { "responseCode": 400 }
      },
      "id": "o-respond-400-malformed",
      "name": "Respond 400 Malformed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-1600, 60],
      "notes": "Rare: a valid signature but structurally invalid body. Still handled rather than assumed impossible -- worth logging/investigating since it could indicate a sender-side bug."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.IDEMPOTENCY_API_URL }}/check/{{ $json.order_id }}",
        "options": { "timeout": 5000, "response": { "response": { "neverError": true } } }
      },
      "id": "o-idem-check",
      "name": "Check Idempotency",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1600, -140],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "notes": "Payment/order webhooks are commonly retried by the sender on timeout or non-2xx. Without this, a retry could double-reserve inventory or double-create an order."
    },
    {
      "parameters": { "mode": "combine", "combineBy": "combineByPosition", "options": {} },
      "id": "o-merge-idem",
      "name": "Merge Idempotency + Order",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [-1400, -140]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.exists }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }],
          "combinator": "and"
        }
      },
      "id": "o-if-already",
      "name": "Already Processed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-1200, -140]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.result }}",
        "options": { "responseCode": 200 }
      },
      "id": "o-respond-cached",
      "name": "Respond Cached Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-1000, -280]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVENTS_STORE_API_URL }}/events",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "order_id", "value": "={{ $json.order_id }}" },
            { "name": "amount", "value": "={{ $json.amount }}" },
            { "name": "currency", "value": "={{ $json.currency }}" },
            { "name": "line_items", "value": "={{ $json.line_items }}" },
            { "name": "customer_email", "value": "={{ $json.customer_email }}" },
            { "name": "received_at", "value": "={{ new Date().toISOString() }}" }
          ]
        },
        "options": { "timeout": 10000, "response": { "response": { "neverError": true, "fullResponse": true } } }
      },
      "id": "o-persist-event",
      "name": "Durably Persist Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1000, -140],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
      "notes": "Must succeed (or exhaust retries) BEFORE we ack the webhook -- this is what makes the fast-ack-then-continue pattern below safe: if the process dies right after acking, the event survives durably and can be reconciled."
    },
    {
      "parameters": { "mode": "combine", "combineBy": "combineByPosition", "options": {} },
      "id": "o-merge-persist",
      "name": "Merge Persist Result + Order",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [-800, -140]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.statusCode }}", "rightValue": 400, "operator": { "type": "number", "operation": "lt" } }],
          "combinator": "and"
        }
      },
      "id": "o-if-persist-ok",
      "name": "Persisted OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-600, -140]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"event_persist_failed\", \"order_id\": $json.order_id } }}",
        "options": { "responseCode": 500 }
      },
      "id": "o-respond-500-persist-failed",
      "name": "Respond 500 Persist Failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-400, 60],
      "notes": "Deliberately does NOT ack. If we couldn't even durably log the event after retries, we want the sender's own webhook retry to give us another shot -- this is the one failure mode where relying on the sender's retry is correct."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"accepted\", \"order_id\": $json.order_id } }}",
        "options": { "responseCode": 200 }
      },
      "id": "o-respond-accepted",
      "name": "Respond 200 Accepted (fast ack)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-400, -220],
      "notes": "n8n continues executing the nodes after a Respond-to-Webhook node -- the HTTP response has already gone out, but this same execution keeps running fulfillment below. That's the whole point: ack fast so the sender never times out, then do the slower work without making them wait."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INVENTORY_API_URL }}/reserve",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "order_id", "value": "={{ $json.order_id }}" },
            { "name": "line_items", "value": "={{ $json.line_items }}" }
          ]
        },
        "options": { "timeout": 15000, "response": { "response": { "neverError": true, "fullResponse": true } } }
      },
      "id": "o-reserve-inventory",
      "name": "Reserve Inventory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-200, -220],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": { "mode": "combine", "combineBy": "combineByPosition", "options": {} },
      "id": "o-merge-inventory",
      "name": "Merge Inventory Result + Order",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [0, -220]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.statusCode }}", "rightValue": 400, "operator": { "type": "number", "operation": "lt" } }],
          "combinator": "and"
        }
      },
      "id": "o-if-inventory-ok",
      "name": "Inventory Reserved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [200, -220]
    },
    {
      "parameters": {
        "jsCode": "const t = $json;\nreturn [{ json: { order_id: t.order_id, status: 'backordered', reason: 'insufficient inventory', customer_email: t.customer_email } }];"
      },
      "id": "o-build-outcome-backordered",
      "name": "Build Backordered Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 20]
    },
    {
