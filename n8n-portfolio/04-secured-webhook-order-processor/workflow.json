      },
      "id": "o-update-status",
      "name": "Update Event Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, -220],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "notes": "Final durable record of how this order was ultimately handled -- what a reconciliation job or support agent checks when a customer asks 'where's my order'."
